# Normalise line endings so contributors on Windows, macOS and Linux see the
# same diffs. Text files are stored LF in the repository and checked out with
# each platform's native endings.
* text=auto eol=lf

*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.jsonl text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Batch and PowerShell need CRLF to run correctly on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.joblib binary
*.pt binary
*.pkl binary
*.db binary
*.zip binary
*.gz binary

# Keep generated example projects out of language statistics.
examples/** linguist-documentation
